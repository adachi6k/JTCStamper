<Window x:Class="JTCStamper.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="JTCスタンパー — 最小版" Width="1060" Height="760" MinWidth="850" MinHeight="650" Background="#F4F5F7"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="JTC スタンパー" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="生成履歴を手元に残す日付印" Margin="0,6,0,20" Foreground="#555555"/></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,18"><Image x:Name="Preview" Height="190" Stretch="Uniform"/></Border><TextBlock Text="氏名"/><TextBox x:Name="NameInput" Text="山田" MaxLength="16" TextChanged="InputsChanged"/><TextBlock Text="印影に表示する日付"/><DatePicker x:Name="DateInput" SelectedDateChanged="DateChanged" Margin="0,5,0,12"/><TextBlock Text="下段文字"/><TextBox x:Name="BottomInput" Text="確認" MaxLength="16" TextChanged="InputsChanged"/><Button x:Name="CopyButton" Content="生成して PNG コピー" Click="CopyClick" Background="#AF2630" Foreground="White"/><TextBlock Text="表示日付と実際の生成時刻は別々に保存します。" TextWrapping="Wrap" Margin="0,8"/></StackPanel><Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="生成履歴" FontSize="19" Margin="0,0,0,10"/><ListBox x:Name="History" Grid.Row="1" DisplayMemberPath="Label" SelectionChanged="HistoryChanged"/><TextBox x:Name="Details" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/><StackPanel Grid.Row="3"><TextBlock Text="用途・貼付先などの注釈（後から追記）" Margin="0,12,0,0"/><TextBox x:Name="NoteInput" MaxLength="2000"/><WrapPanel><Button Content="注釈を追記" Click="NoteClick"/><Button Content="原本を保存" Click="ExportClick"/></WrapPanel><TextBlock Text="コピー記録は貼付完了を示しません。画像照合・EMFは未実装です。" TextWrapping="Wrap" Foreground="#555555"/></StackPanel></Grid></Grid><TextBlock x:Name="Status" Grid.Row="2" TextWrapping="Wrap" Margin="0,18,0,0"/></Grid></Window>