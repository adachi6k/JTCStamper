<Window x:Class="JTCStamper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="JTC Stamper" Width="960" Height="700" MinWidth="860" MinHeight="620"
        FontFamily="Yu Gothic UI, Segoe UI" FontSize="15" UseLayoutRounding="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" GlassFrameThickness="1"
                            UseAeroCaptionButtons="False" NonClientFrameEdges="Left,Right,Bottom"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Template>
        <ControlTemplate TargetType="Window">
            <Border Background="{TemplateBinding Background}"><AdornerDecorator><ContentPresenter/></AdornerDecorator></Border>
        </ControlTemplate>
    </Window.Template>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CaptionControls.xaml"/></ResourceDictionary.MergedDictionaries>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,3,6,3"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="0,3,0,8"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="32" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="CaptionButtonsColumn" Width="138"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="WindowMenuButton" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="WindowMenuClick" ToolTip="ウィンドウの操作" AutomationProperties.Name="ウィンドウの操作"
                    Style="{StaticResource CaptionButton}" Width="36">
                <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" Width="16" Height="16"/>
            </Button>
            <Menu x:Name="TitleMenu" Grid.Column="1" VerticalAlignment="Center" Background="Transparent"
                  Padding="0" Margin="0" FontSize="13"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <MenuItem Header="ファイル(_F)" Style="{StaticResource CompactCaptionMenuItem}">
                <MenuItem Header="印面設定を開く(_O)…" Click="OpenSettingsClick"/>
                <MenuItem Header="印面設定を保存(_S)" Click="SaveSettingsClick"/>
                <MenuItem Header="名前を付けて保存(_A)…" Click="SaveSettingsAsClick"/>
                <Separator/>
                <MenuItem Header="終了(_X)" Click="ExitClick"/>
            </MenuItem>
            <MenuItem Header="履歴(_R)" Style="{StaticResource CompactCaptionMenuItem}">
                <MenuItem Header="生成履歴を表示" Click="ShowHistoryClick"/>
                <Separator/>
                <MenuItem Header="実行ファイルのフォルダーを使用" Click="DefaultHistoryClick"/>
                <MenuItem Header="保存先を選択…" Click="ChooseHistoryClick"/>
                <Separator/>
                <MenuItem Header="履歴をバックアップ（同じWindowsユーザー用）…" Click="BackupHistoryClick"/>
                <MenuItem Header="同じWindowsユーザー用バックアップを復元…" Click="RestoreHistoryClick"/>
                <MenuItem Header="別PCへの移行用バックアップを保存…" Click="PortableBackupClick"/>
                <MenuItem Header="移行用バックアップから復元…" Click="PortableRestoreClick"/>
                <Separator/>
                <MenuItem Header="現在の保存先の生成履歴をすべて削除…" Click="DeleteHistoryClick"/>
            </MenuItem>
            <MenuItem Header="照合(_C)" Style="{StaticResource CompactCaptionMenuItem}"><MenuItem Header="照合画面を開く" Click="VerifyClick"/></MenuItem>
            <MenuItem Header="表示(_V)" Style="{StaticResource CompactCaptionMenuItem}">
                <MenuItem x:Name="StatusDetailsItem" Header="現在の状態を確認(_S)…" Click="StatusDetailsClick"/>
                <Separator/>
                <MenuItem Header="テーマ">
                    <MenuItem x:Name="SystemThemeItem" Header="Windowsの設定に合わせる" Tag="System" IsCheckable="True" Click="ThemeClick"/>
                    <MenuItem x:Name="LightThemeItem" Header="ライト" Tag="Light" IsCheckable="True" Click="ThemeClick"/>
                    <MenuItem x:Name="DarkThemeItem" Header="ダーク" Tag="Dark" IsCheckable="True" Click="ThemeClick"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="ヘルプ(_H)" Style="{StaticResource CompactCaptionMenuItem}"><MenuItem Header="印影照合について" Click="VerificationHelpClick"/><Separator/><MenuItem Header="バージョン情報" Click="AboutClick"/></MenuItem>
            </Menu>
            <!-- Blank space remains HTCAPTION; caption glyphs are rendered explicitly. -->
            <Border x:Name="TitleDragArea" Grid.Column="2" Background="Transparent"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="MinimizeClick" ToolTip="最小化" AutomationProperties.Name="最小化">
                    <Path Width="10" Height="10" Data="M0,5 L10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="MaximizeClick" ToolTip="最大化" AutomationProperties.Name="最大化">
                    <Path x:Name="MaximizeGlyph" Width="10" Height="10" Data="M0,0 H10 V10 H0 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Click="CloseCaptionClick" ToolTip="閉じる" AutomationProperties.Name="閉じる">
                    <Path Width="10" Height="10" Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                </Button>
            </StackPanel>
        </Grid>
        <StatusBar DockPanel.Dock="Bottom" Padding="8,3" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"><ProgressBar x:Name="StoreProgressIndicator" Width="64" Height="4" Margin="0,0,8,0" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="履歴の処理中"/><TextBlock x:Name="Status" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StatusBar>
        <TabControl x:Name="MainTabs" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavigationItem}">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="172"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,10,0,0">
                            <ToggleButton x:Name="NavigationToggle" Style="{StaticResource SidebarToggle}" IsChecked="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, TargetNullValue=False}" Width="40" Height="32" HorizontalAlignment="Right" Margin="0,0,8,4" ToolTip="サイドバーを折りたたむ" AutomationProperties.Name="サイドバーを折りたたむ／展開する">
                                <Path x:Name="SidebarToggleIcon" Data="M4,1 H18 Q20,1 20,3 V17 Q20,19 18,19 H4 Q2,19 2,17 V3 Q2,1 4,1 Z M8,1 V19 M5,5 V6 M5,9 V10 M5,13 V14" Width="22" Height="20" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="1.5"/>
                            </ToggleButton>
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Margin="0,8,8,0" CornerRadius="12" BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="4"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="NavigationToggle" Property="IsChecked" Value="True">
                            <Setter TargetName="NavigationColumn" Property="Width" Value="56"/>
                            <Setter TargetName="NavigationToggle" Property="ToolTip" Value="サイドバーを展開する"/>

                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </TabControl.Template>
            <TabItem x:Name="CreateTab" Header="印影を作成" Tag="M5,12 V8 C2,1 14,1 11,8 V12 M3,12 H13 V16 H3 Z M1,19 H15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="印影を作成" Style="{StaticResource PageHeading}" Grid.ColumnSpan="3"/>
                <GroupBox Grid.Row="1" Header="プレビュー" VerticalAlignment="Top">
                    <Border Background="White" Padding="6"><Image x:Name="Preview" Height="200" Stretch="Uniform"/></Border>
                </GroupBox>
            <StackPanel x:Name="StampInputs" Grid.Row="1" Grid.Column="2" MaxWidth="420" HorizontalAlignment="Stretch">
                <TextBlock Text="上段文字"/><TextBox x:Name="NameInput" Text="JTC" MaxLength="16" TextChanged="InputsChanged"/>
                <TextBlock Text="表示日付"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock x:Name="DateModeLabel" Text="当日" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TodayDisplay" VerticalAlignment="Center"/>
                    <DatePicker x:Name="DateInput" Visibility="Collapsed" IsEnabled="False"
                                SelectedDateChanged="DateChanged" Width="125"/>
                    <Button x:Name="DateModeButton" Content="日付を指定…" Click="DateModeClick" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="下段文字"/><TextBox x:Name="BottomInput" Text="(印)" MaxLength="16" TextChanged="InputsChanged"/>
                <CheckBox x:Name="PlainMode" Content="プレーン印影（幾何コードを埋め込まない）" Checked="PlainModeChanged" Unchecked="PlainModeChanged" Margin="0,6,0,4"/>
                <TextBlock Text="用途・貼付先（任意）" Margin="0,4,0,0"/>
                <TextBox x:Name="PurposeInput" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" Height="52" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="用途・貼付先（任意）" ToolTip="例：○○社向け見積書に使用予定。印影には表示されません。"/>
                <Button x:Name="CopyButton" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="12,7" Margin="0,6,0,4" Content="生成して PNG コピー" Click="CopyClick"/>
                <TextBlock x:Name="ModeHelp" Text="円周の短い欠けは生成時に決まります。" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0">
                            <DockPanel LastChildFill="True">
                                <Button x:Name="AllHistoryButton" DockPanel.Dock="Right" Content="すべての履歴を見る" Click="ShowHistoryClick" Margin="0,0,0,6"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="RecentHistoryHeading" Text="直近の生成履歴" FontWeight="SemiBold"/>
                                    <TextBlock Text="新しく生成した順。行を選ぶと詳細・注釈を開きます。" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="RecentHistoryMessage" Text="履歴を読み込んでいます。" Margin="0,8" TextWrapping="Wrap"/>
                            <ItemsControl x:Name="RecentHistory">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding Id}" Click="RecentHistoryClick" HorizontalContentAlignment="Stretch"
                                                Padding="6,4" Margin="0,2,0,0" ToolTip="{Binding Label}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Background="White" Margin="0,0,8,0"><Image Source="{Binding Thumbnail}" Height="40" Width="40" ToolTip="{Binding ImageDescription}"/></Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PurposeLabel}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding StampLabel}" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"><Run Text="{Binding GeneratedLabel}"/><Run Text="  ／  "/><Run Text="{Binding CopyState}"/></TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="生成・コピーの記録です。貼付完了を示すものではありません。" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="VerificationTab" Header="印影を照合" Tag="M12,7 A5,5 0 1 1 2,7 A5,5 0 1 1 12,7 M11,11 L17,17" IsEnabled="False">
                <ContentControl x:Name="VerificationHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            </TabItem>
            <TabItem x:Name="HistoryTab" Header="生成履歴" Tag="M2,8 A7,7 0 1 1 3,14 M2,2 V8 H8 M10,5 V10 L13,12">
            <Grid Margin="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="160"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="生成履歴" Style="{StaticResource PageHeading}"/>
                <ListBox x:Name="History" Grid.Row="1" DisplayMemberPath="Label" SelectionChanged="HistoryChanged"/>
                <DockPanel Grid.Row="2" Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Left" Width="144" Margin="0,0,8,0">
                        <Border Background="White"><Image x:Name="HistoryPreview" Height="112" Stretch="Uniform"/></Border>
                        <TextBlock x:Name="HistoryImageDescription" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </DockPanel>
                <StackPanel Grid.Row="3">
                    <TextBlock Text="用途・貼付先などの注釈" Margin="0,10,0,0"/>
                    <TextBox x:Name="NoteInput" MaxLength="2000"/>
                    <WrapPanel><Button x:Name="NoteButton" Content="注釈を追記" Click="NoteClick"/><Button x:Name="ExportButton" Content="原本を保存" Click="ExportClick"/></WrapPanel>
                    <TextBlock Text="コピー記録は貼付完了を示しません。" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
